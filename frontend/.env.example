# Copy to .env.local (dev) or set in your host's dashboard (prod).

# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://getmaxsolutions.com
# Shown on the site as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=info@getmaxsolutions.com
# WhatsApp number, digits only with country code (e.g. 919876543210). Leave empty to hide WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Audit form email delivery (https://resend.com — verify getmaxsolutions.com there first).
RESEND_API_KEY=
# Where leads are sent; comma-separate multiple inboxes.
LEAD_TO_EMAIL=
# Must be on a domain verified in Resend.
LEAD_FROM_EMAIL=Getmax Leads <info@getmaxsolutions.com>
